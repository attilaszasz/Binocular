# Binocular — Environment Variables
# All variables are optional. Defaults shown.

# Logging
BINOCULAR_LOG_FORMAT=console    # "console" (human-readable) or "json" (structured)
BINOCULAR_LOG_LEVEL=info        # debug, info, warning, error

# Server
BINOCULAR_HOST=0.0.0.0
BINOCULAR_PORT=8000

# Paths (inside the container)
BINOCULAR_DATA_DIR=/app/data
BINOCULAR_MODULES_DIR=/app/modules
BINOCULAR_DB_PATH=/app/data/binocular.db # Custom SQLite database path override

# Module timeouts
BINOCULAR_MODULE_TIMEOUT=30.0

# Optional Basic Authentication (off by default)
BINOCULAR_BASIC_AUTH_ENABLED=false
BINOCULAR_BASIC_AUTH_USERNAME=binocular
BINOCULAR_BASIC_AUTH_PASSWORD=                  # Required if enabled is true

# Secrets Loading via File Paths (Docker Secret / _FILE pattern)
# Any of these variables can be loaded from a mounted file by pointing to its path.
# When specified, the file-based variable takes precedence over the direct environment variable.
# Example:
# BINOCULAR_BASIC_AUTH_PASSWORD_FILE=/run/secrets/basic_auth_password
# BINOCULAR_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# BINOCULAR_GOTIFY_TOKEN_FILE=/run/secrets/gotify_token

# Container user mapping (used by entrypoint.sh, not the app)
PUID=1000
PGID=1000
