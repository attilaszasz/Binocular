# Binocular defaults target a private trusted LAN.
# Copy to .env and adjust values for your deployment.

BINOCULAR_HOST=0.0.0.0
BINOCULAR_PORT=8000
BINOCULAR_DATA_DIR=/app/data
BINOCULAR_MODULES_DIR=/app/modules

# Optional light HTTP basic auth. Disabled by default.
# Basic auth is not a substitute for trusted-network isolation or TLS.
BINOCULAR_AUTH_ENABLED=false
BINOCULAR_AUTH_USERNAME=
BINOCULAR_AUTH_PASSWORD=
BINOCULAR_AUTH_PASSWORD_FILE=